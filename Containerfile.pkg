# --------------------------------------------------------------------------
# THIS FILE IS AUTOGENERATED - DO NOT EDIT MANUALLY
#
# Source: Containerfile.pkg.j2
# --------------------------------------------------------------------------

ARG BASE_VERSION=15.1
FROM ghcr.io/daemonless/base-exec:${BASE_VERSION}

ARG FREEBSD_ARCH=amd64
ARG PKG_NAME="crowdsec"
ARG PACKAGES="${PKG_NAME} ca_root_nss"
ARG HEALTHCHECK_ENDPOINT="http://127.0.0.1:8080/health"

ENV HEALTHCHECK_URL="${HEALTHCHECK_ENDPOINT}"

LABEL org.opencontainers.image.title="CrowdSec" \
      org.opencontainers.image.description="Open-source collaborative intrusion detection and prevention engine (IDS/IPS and AppSec WAF) with crowdsourced threat intelligence." \
      org.opencontainers.image.source="https://github.com/daemonless/crowdsec" \
      org.opencontainers.image.url="https://www.crowdsec.net/" \
      org.opencontainers.image.documentation="https://docs.crowdsec.net/" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="daemonless" \
      org.opencontainers.image.authors="daemonless" \
      io.daemonless.category="Infrastructure" \
      io.daemonless.port="8080" \
      io.daemonless.volumes="/config" \
      io.daemonless.arch="${FREEBSD_ARCH}" \
      io.daemonless.pkg-source="pkg" \
      io.daemonless.packages="${PACKAGES}" \
      io.daemonless.pkg-name="${PKG_NAME}" \
      io.daemonless.healthcheck-url="${HEALTHCHECK_ENDPOINT}"

# Install CrowdSec from FreeBSD packages, move default config into /defaults,
# and symlink standard config and data paths into /config.
RUN pkg update && \
    pkg install -y ${PACKAGES} && \
    mkdir -p /app /defaults/etc /config/etc /config/data /var/db/crowdsec && \
    pkg query '%v' ${PKG_NAME} > /app/version && \
    mv /usr/local/etc/crowdsec /defaults/etc/crowdsec && \
    sed -i '' \
      -e 's|^  daemonize: true|  daemonize: false|' \
      -e 's|^  log_media: file|  log_media: stdout|' \
      -e 's|^    listen_uri: 127\.0\.0\.1:8080|    listen_uri: 0.0.0.0:8080|' \
      -e '/^prometheus:/,/^pprof:/s|^  listen_addr: 127\.0\.0\.1|  listen_addr: 0.0.0.0|' \
      -e 's|^  user: nobody|  user: bsd|' \
      -e 's|^  group: nogroup|  group: bsd|' \
      /defaults/etc/crowdsec/config.yaml && \
    rm -f /defaults/etc/crowdsec/local_api_credentials.yaml \
          /defaults/etc/crowdsec/online_api_credentials.yaml && \
    printf '%s\n' \
      'source: file' \
      'filename: /does/not/exist' \
      'labels:' \
      '  type: syslog' > /defaults/etc/crowdsec/acquis.yaml && \
    ln -s /config/etc /usr/local/etc/crowdsec && \
    ln -s /config/etc /etc/crowdsec && \
    rm -rf /var/db/crowdsec/data && \
    ln -s /config/data /var/db/crowdsec/data && \
    chmod -R a+rX /defaults /app && \
    chown -R bsd:bsd /config /usr/local/lib/crowdsec/plugins && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

COPY root/ /
RUN chmod +x /daemonless/libexec/crowdsec /daemonless/init.d/* /healthz

WORKDIR /config
CMD ["/daemonless/libexec/crowdsec"]

# 8080: LAPI; 6060: Prometheus metrics; 7422: AppSec WAF
EXPOSE 8080 6060 7422
VOLUME /config